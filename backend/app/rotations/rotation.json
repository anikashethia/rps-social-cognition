{
  "_note": "Block-order configs for the 6-block RPS design (2 agents × 3 CHASE levels). Avatar IDs are resolved at runtime from the participant's registration (IOS-based friendly/neutral assignment via /api/participants/{id}/registration). The config index determines block ordering only.",

  "_design": "6 blocks: 1 friendly agent + 1 neutral agent (selected via IOS self-other overlap), each played at CHASE levels 0, 1, and 2. Block order is counterbalanced across participants via config index (6 configs, cycling through participants).",

  "_structure": {
    "blocks": "ordered array of 6 entries; array order = block presentation order in the RPS task",
    "blocks[].condition": "friendly | neutral — resolved to avatar_id at runtime from participant registration",
    "blocks[].level": "CHASE level for the opponent agent in this block (0 = egocentric/non-strategic, 1 = level-1, 2 = level-2)"
  },

  "configs": {
    "1": {
      "blocks": [
        { "condition": "friendly", "level": 0 },
        { "condition": "neutral",  "level": 1 },
        { "condition": "friendly", "level": 2 },
        { "condition": "neutral",  "level": 0 },
        { "condition": "friendly", "level": 1 },
        { "condition": "neutral",  "level": 2 }
      ]
    },
    "2": {
      "blocks": [
        { "condition": "neutral",  "level": 0 },
        { "condition": "friendly", "level": 1 },
        { "condition": "neutral",  "level": 2 },
        { "condition": "friendly", "level": 0 },
        { "condition": "neutral",  "level": 1 },
        { "condition": "friendly", "level": 2 }
      ]
    },
    "3": {
      "blocks": [
        { "condition": "friendly", "level": 1 },
        { "condition": "neutral",  "level": 2 },
        { "condition": "friendly", "level": 0 },
        { "condition": "neutral",  "level": 1 },
        { "condition": "friendly", "level": 2 },
        { "condition": "neutral",  "level": 0 }
      ]
    },
    "4": {
      "blocks": [
        { "condition": "neutral",  "level": 1 },
        { "condition": "friendly", "level": 2 },
        { "condition": "neutral",  "level": 0 },
        { "condition": "friendly", "level": 1 },
        { "condition": "neutral",  "level": 2 },
        { "condition": "friendly", "level": 0 }
      ]
    },
    "5": {
      "blocks": [
        { "condition": "friendly", "level": 2 },
        { "condition": "neutral",  "level": 0 },
        { "condition": "friendly", "level": 1 },
        { "condition": "neutral",  "level": 2 },
        { "condition": "friendly", "level": 0 },
        { "condition": "neutral",  "level": 1 }
      ]
    },
    "6": {
      "blocks": [
        { "condition": "neutral",  "level": 2 },
        { "condition": "friendly", "level": 0 },
        { "condition": "neutral",  "level": 1 },
        { "condition": "friendly", "level": 2 },
        { "condition": "neutral",  "level": 0 },
        { "condition": "friendly", "level": 1 }
      ]
    }
  }
